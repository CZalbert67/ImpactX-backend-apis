{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "UseCosmosDb": true,
  "UseInMemoryDatabase": false,
  "AzureCosmosDb": {
    "Endpoint": "https://impactx-db-west-final.documents.azure.com:443/",
    "Key": "YOUR_AZURE_COSMOS_KEY",
    "DatabaseName": "ImpactX-Data"
  },
  "Jwt": {
    "Issuer": "ImpactX-Dev",
    "Audience": "ImpactX-Client-Dev",
    "ExpirationMinutes": 15
  }
}

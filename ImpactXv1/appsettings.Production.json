{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "UseCosmosDb": true,
  "UseInMemoryDatabase": false,
  "DatabaseInitialization": {
    "Enabled": true,
    "Mode": "ValidateOnly",
    "MaxAttempts": 3,
    "RetryDelaySeconds": 5,
    "TimeoutSeconds": 60
  },
  "AzureCosmosDb": {
    "Endpoint": "https://impactx-db-west-final.documents.azure.com:443/",
    "Key": "YOUR_AZURE_COSMOS_KEY",
    "DatabaseName": "ImpactX-Data",
    "SharedThroughput": 400,
    "RequestTimeoutSeconds": 30,
    "MaxRetryAttemptsOnRateLimitedRequests": 3,
    "MaxRetryWaitTimeSeconds": 30
  },
  "Jwt": {
    "Issuer": "ImpactX-Prod",
    "Audience": "ImpactX-Client-Prod",
    "ExpirationMinutes": 15
  },
  "ImpactDetection": {
    "Enabled": true,
    "PendingDispatchWorkerEnabled": true,
    "PollIntervalSeconds": 2,
    "ActiveAlertCooldownSeconds": 60
  },
  "SubscriptionLifecycle": {
    "Enabled": true,
    "PollIntervalMinutes": 15
  },
  "RateLimiting": {
    "Auth": {
      "RegisterPerMinute": 3,
      "LoginPerMinute": 10,
      "RefreshPerMinute": 30,
      "RecoverEveryMinutes": 15,
      "RecoverPerWindow": 3,
      "ResetEveryMinutes": 15,
      "ResetPerWindow": 5
    },
    "Monitors": {
      "InviteDetailsPerMinute": 10,
      "InviteActionPerMinutePerUser": 15,
      "InviteCreatePerHourPerUser": 10
    },
    "Devices": {
      "FcmTokenPerMinutePerUser": 20
    },
    "Telemetry": {
      "IngestionPerMinutePerUser": 120
    },
    "Incidents": {
      "CreatePerMinutePerUser": 10
    },
    "Alerts": {
      "DetectPerMinutePerUser": 30,
      "SosPerMinutePerUser": 5
    }
  }
}

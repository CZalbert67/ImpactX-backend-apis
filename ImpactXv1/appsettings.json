{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "Auth": {
      "RegisterPerMinute": 5,
      "LoginPerMinute": 10,
      "RefreshPerMinute": 30,
      "RecoverEveryMinutes": 15,
      "RecoverPerWindow": 3,
      "ResetEveryMinutes": 15,
      "ResetPerWindow": 5
    },
    "Monitors": {
      "InviteDetailsPerMinute": 20,
      "InviteActionPerMinutePerUser": 20,
      "InviteCreatePerHourPerUser": 10
    },
    "Devices": {
      "FcmTokenPerMinutePerUser": 30
    },
    "Telemetry": {
      "IngestionPerMinutePerUser": 120
    },
    "Incidents": {
      "CreatePerMinutePerUser": 20
    },
    "Alerts": {
      "DetectPerMinutePerUser": 30,
      "SosPerMinutePerUser": 10
    }
  },
  "UseCosmosDb": true,
  "UseInMemoryDatabase": false,
  "AzureCosmosDb": {
    "Endpoint": "https://impactx-db-west-final.documents.azure.com:443/",
    "Key": "YOUR_AZURE_COSMOS_KEY",
    "DatabaseName": "ImpactX-Data"
  },
  "Jwt": {
    "Issuer": "ImpactX",
    "Audience": "ImpactX-Client",
    "ExpirationMinutes": 15
  }
}
